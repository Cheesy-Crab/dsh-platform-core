  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./events": "./src/events.js",
    "./delivery": "./src/delivery.js",
    "./adapter-host": "./src/adapter-host.js",
    "./profiles": "./src/profiles.js",
    "./manifest": "./src/manifest.js",
    "./plugin-adapter": "./src/plugin-adapter.js",
    "./registry": "./src/registry.js",
    "./prompts": "./src/prompts/index.js",
    "./delivery-coordinator": "./src/delivery-coordinator.js",
    "./invocation-ledger": "./src/invocation-ledger.js",
    "./agent-policy": "./src/agent-policy.js",
    "./status": "./src/status.js",
    "./fabric": "./src/fabric.js",
    "./effect-ledger": "./src/effect-ledger.js",
    "./tool-exposure": "./src/tool-exposure.js",
    "./capability-bindings": "./src/capability-bindings.js",
    "./profile-state": "./src/profile-state.js",
    "./tool-usage": "./src/tool-usage.js",
    "./profile-predictor": "./src/profile-predictor.js",
    "./user-capability-state": "./src/user-capability-state.js",
    "./capability-validation": "./src/capability-validation.js",
    "./capability-family": "./src/capability-family.js",
    "./prediction-log": "./src/prediction-log.js",
    "./tool-guard": "./src/tool-guard.js",
    "./tool-invocation": "./src/tool-invocation.js"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cheesy-Crab/dsh-platform-core.git"
  },
  "bugs": {
    "url": "https://github.com/Cheesy-Crab/dsh-platform-core/issues"
  },
  "homepage": "https://github.com/Cheesy-Crab/dsh-platform-core#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "platform",
    "capability",
    "plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "platform": {
      "contract": "1.2",
      "capabilities": [
        {
          "id": "platform.core",
          "kind": "knowledge",
          "title": "Platform Core",
          "description": "Surface-neutral platform runtime: capability registry, plugin discovery, prompt policy and media delivery."
        }
      ],
      "profiles": []
    }
  },
  "scripts": {
    "test": "node --test --test-force-exit",
    "check": "node scripts/check-manifests.mjs"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2"
  },
  "license": "MIT"
}
